const express = require("express");
const { createClient } = require("@supabase/supabase-js");

const router = express.Router();

/* =========================================================
   SUPABASE
========================================================= */

const SUPABASE_URL =
  process.env.SUPABASE_URL;

const SUPABASE_SECRET_KEY =
  process.env.SUPABASE_SECRET_KEY;

if (!SUPABASE_URL) {
  throw new Error(
    "Missing SUPABASE_URL"
  );
}

if (!SUPABASE_SECRET_KEY) {
  throw new Error(
    "Missing SUPABASE_SECRET_KEY"
  );
}

const supabase = createClient(
  SUPABASE_URL,
  SUPABASE_SECRET_KEY,
  {
    auth: {
      autoRefreshToken: false,
      persistSession: false
    }
  }
);


/* =========================================================
   HELPER — FIND PROFILE
========================================================= */

async function getProfile(userId) {

  const {
    data,
    error
  } = await supabase
    .from("profiles")
    .select("*")
    .eq("id", userId)
    .maybeSingle();

  if (error) {
    throw error;
  }

  return data;
}


/* =========================================================
   GET CURRENT USER
   GET /api/me
========================================================= */

router.get(
  "/me",
  async (req, res) => {

    try {

      if (!req.user) {

        return res.status(401).json({
          ok: false,
          message:
            "Authentication required."
        });

      }

      const user =
        req.user;

      let profile = null;

      try {

        profile =
          await getProfile(
            user.id
          );

      } catch (error) {

        console.error(
          "Profile lookup error:",
          error.message
        );

      }


      /* -----------------------------------------------------
         SAFE USER RESPONSE
      ----------------------------------------------------- */

      return res.json({

        ok: true,

        user: {

          id:
            user.id,

          email:
            user.email || "",

          full_name:
            profile?.full_name ||
            user.user_metadata?.full_name ||
            "",

          phone:
            profile?.phone ||
            user.user_metadata?.phone ||
            "",

          country:
            profile?.country ||
            user.user_metadata?.country ||
            "",

          balance:
            Number(
              profile?.balance || 0
            ),

          owned_bikes:
            Number(
              profile?.owned_bikes || 0
            ),

          rewards:
            Number(
              profile?.rewards || 0
            ),

          referral_rewards:
            Number(
              profile?.referral_rewards || 0
            ),

          referral_code:
            profile?.referral_code ||
            "",

          kyc_status:
            profile?.kyc_status ||
            "pending"

        }

      });

    } catch (error) {

      console.error(
        "GET /api/me error:",
        error
      );

      return res.status(500).json({

        ok: false,

        message:
          "Unable to load account information."

      });

    }

  }
);


