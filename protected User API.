/* =========================================================
   GET USER TRANSACTIONS
   GET /api/account/transactions
========================================================= */

router.get(
  "/account/transactions",
  async (req, res) => {

    try {

      if (!req.user) {

        return res.status(401).json({
          ok: false,
          message:
            "Authentication required."
        });

      }


      /*
        We query the transactions table if it exists.

        The table will be created in the database
        stage. Until then, this endpoint returns
        an empty transaction list instead of exposing
        a database error to the user.
      */

      const {
        data,
        error
      } = await supabase
        .from("transactions")
        .select(`
          id,
          type,
          amount,
          currency,
          network,
          status,
          created_at
        `)
        .eq(
          "user_id",
          req.user.id
        )
        .order(
          "created_at",
          {
            ascending: false
          }
        )
        .limit(50);


      if (error) {

        console.warn(
          "Transactions table unavailable:",
          error.message
        );

        return res.json({

          ok: true,

          transactions: []

        });

      }


      return res.json({

        ok: true,

        transactions:
          data || []

      });

    } catch (error) {

      console.error(
        "Transactions error:",
        error
      );

      return res.status(500).json({

        ok: false,

        message:
          "Unable to load transactions."

      });

    }

  }
);


