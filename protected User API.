/* =========================================================
   GET REFERRAL SUMMARY
   GET /api/account/referrals
========================================================= */

router.get(
  "/account/referrals",
  async (req, res) => {

    try {

      if (!req.user) {

        return res.status(401).json({
          ok: false,
          message:
            "Authentication required."
        });

      }


      const profile =
        await getProfile(
          req.user.id
        );


      let referrals = [];

      try {

        const {
          data,
          error
        } = await supabase
          .from("referrals")
          .select(`
            id,
            referred_user_id,
            level,
            commission,
            status,
            created_at
          `)
          .eq(
            "referrer_id",
            req.user.id
          )
          .order(
            "created_at",
            {
              ascending: false
            }
          );


        if (!error) {

          referrals =
            data || [];

        }

      } catch (error) {

        console.warn(
          "Referral table unavailable:",
          error.message
        );

      }


      return res.json({

        ok: true,

        referral: {

          code:
            profile?.referral_code ||
            "",

          levels: {

            level_1: "10%",

            level_2: "3%",

            level_3: "2%"

          },

          total_rewards:
            Number(
              profile?.referral_rewards ||
              0
            ),

          referrals

        }

      });

    } catch (error) {

      console.error(
        "Referral summary error:",
        error
      );

      return res.status(500).json({

        ok: false,

        message:
          "Unable to load referral information."

      });

    }

  }
);


